{
    "extends": ["stylelint-config-recommended-scss"],
    "rules": {
        "scss/comment-no-empty": null,
        "scss/no-global-function-names": null,
        "scss/at-extend-no-missing-placeholder": null,
        "font-family-no-missing-generic-family-keyword": [true, {"ignoreFontFamilies": ["/^tabler-icons/"]}],
        "color-no-hex": [true, {"message": "Use a design token (docs/develop/concept-design-tokens.md)"}],
        "function-disallowed-list": [["darken", "lighten"], {"message": "Use a design token or color-mix() (docs/develop/concept-design-tokens.md)"}]
    },
    "overrides": [
        {
            "files": ["**/variables.scss", "**/_root.scss"],
            "rules": {
                "color-no-hex": null,
                "function-disallowed-list": null
            }
        }
    ]
}
